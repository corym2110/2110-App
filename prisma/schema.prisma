generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Coach {
  id          String            @id @default(cuid())
  name        String
  email       String            @unique
  role        String
  isAdmin     Boolean           @default(false)
  active      Boolean           @default(true)
  /** Record<DayOfWeek, { on: boolean; shifts: { start: number; end: number }[] }> */
  weeklyHours Json?
  /** { dayAhead: boolean; manualBooking: boolean; classJoin: boolean } */
  notifyFlags Json?
  landing     String            @default("Dashboard")
  calendarView String           @default("Week")
  /** Payroll commission fraction (0.25 = 25%) for Personal Training / Group Training / Remote
      Consult / Blueprint and Baseline sessions — set per coach (tenure-based in practice, but
      not auto-computed from a formula). 0 doubles as "not configured yet". */
  commissionRate Float          @default(0)
  members     Member[]
  sales       Sale[]
  timeOff     TimeOff[]
  bookings    Booking[]
  series      RecurringSeries[]
  waiversWitnessed WaiverSignature[]
  sessionCredits   SessionCredit[]
  products         Product[]
}

model TimeOff {
  id      String @id @default(cuid())
  coachId String
  coach   Coach  @relation(fields: [coachId], references: [id], onDelete: Cascade)
  fromIso String
  toIso   String
  reason  String
  type    String // "Full days" | "Partial day"
}

/** A single booked session on a specific date — created directly, or as a one-off
    edit/move of a RecurringSeries occurrence (which excludes that date on the series). */
model Booking {
  id        String   @id @default(cuid())
  iso       String
  start     Int
  duration  Int
  type      String
  capacity  Int      @default(0)
  coachId   String
  coach     Coach    @relation(fields: [coachId], references: [id])
  name      String
  roster    String[] @default([])
  createdAt DateTime @default(now())

  @@index([iso])
}

/** A weekly-recurring booking template. `days` maps day label -> start minute
    (e.g. {"Mon": 360, "Wed": 900}), so different days can run at different times.
    `excludedDates` holds any single occurrence that was cancelled or edited/moved
    away (edited occurrences become their own Booking on the new date/time). */
model RecurringSeries {
  id            String   @id @default(cuid())
  clientName    String
  type          String
  capacity      Int      @default(0)
  coachId       String
  coach         Coach    @relation(fields: [coachId], references: [id])
  duration      Int
  days          Json
  fromIso       String
  toIso         String?
  excludedDates String[] @default([])
  createdAt     DateTime @default(now())
}

model AttendanceRecord {
  slotKey   String   @id
  iso       String
  status    String
  updatedAt DateTime @updatedAt

  @@index([iso])
}

model WaitlistEntry {
  id            String   @id @default(cuid())
  occurrenceKey String
  iso           String
  memberName    String
  createdAt     DateTime @default(now())

  @@unique([occurrenceKey, memberName])
  @@index([iso])
}

model ClassAddIn {
  id            String   @id @default(cuid())
  occurrenceKey String
  iso           String
  memberName    String
  createdAt     DateTime @default(now())

  @@unique([occurrenceKey, memberName])
  @@index([iso])
}

model Member {
  id            String          @id @default(cuid())
  firstName     String
  lastName      String
  email         String          @unique
  phone         String
  gender        String
  address       String?
  postalCode    String?
  city          String?
  province      String?
  dateOfBirth           DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  /** Free-text staff notes on this member (injury history, preferences, referral context, etc). */
  notes                 String?         @db.Text
  /** Clover Customer id — the member's saved card on file. Never stores an actual card number;
      the real card lives in Clover's vault, we just keep the reference needed to charge it later.
      Brand/last4/expiry below are display-only, captured from the save response itself rather
      than re-queried from Clover later (that needs a different REST API and credential entirely). */
  cloverCustomerId      String?
  /** The card's own id within that Clover customer (its "source" id) — Clover only allows one
      card on file per customer, so replacing it requires revoking this specific card first. */
  cloverCardId          String?
  cloverCardBrand       String?
  cloverCardLast4       String?
  cloverCardExpiry      String?
  /** Recurring membership billing — a member has at most one active plan, charged
      automatically against the card on file by the charge-memberships cron job.
      `status` "failed" means 3 consecutive charge attempts failed and the job has stopped
      auto-retrying; staff re-activates it once the card's fixed. */
  membershipName        String?
  membershipPrice       Decimal?        @db.Decimal(10, 2)
  membershipStatus      String          @default("none")
  nextBillDate          String?
  billFailCount         Int             @default(0)
  lastBillAt            DateTime?
  lastBillStatus        String?
  lastBillError         String?
  plan          String          @default("No plan yet")
  since         String
  coachId       String?
  coach         Coach?          @relation(fields: [coachId], references: [id])
  payerOf       SharedAccount[] @relation("Payer")
  beneficiaryOf SharedAccount[] @relation("Beneficiary")
  sales         Sale[]
  waivers       WaiverSignature[]
  sessionCredits SessionCredit[]
  createdAt     DateTime        @default(now())
}

/** A signed liability waiver, captured in person on a staff device. `contentSnapshot` freezes the
    exact wording shown at signing time, so a later edit to the waiver text in code never changes
    what a historical record appears to say. */
model WaiverSignature {
  id               String   @id @default(cuid())
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  waiverType       String
  contentSnapshot  String   @db.Text
  signerName       String
  minorName        String?
  pickupNames      String[] @default([])
  signatureDataUrl String   @db.Text
  signedByCoachId  String?
  signedByCoach    Coach?   @relation(fields: [signedByCoachId], references: [id])
  createdAt        DateTime @default(now())

  @@index([memberId])
}

model SharedAccount {
  id            String @id @default(cuid())
  payerId       String
  payer         Member @relation("Payer", fields: [payerId], references: [id], onDelete: Cascade)
  beneficiaryId String
  beneficiary   Member @relation("Beneficiary", fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([payerId, beneficiaryId])
}

/** A POS sale — paid immediately (Card/Cash/E-transfer/Package credit) or left unpaid ("Invoice"), which
    is what drives a member's real balance-due (computed as the sum of their unpaid sales). */
model Sale {
  id        String   @id @default(cuid())
  memberId  String?
  member    Member?  @relation(fields: [memberId], references: [id])
  coachId   String?
  coach     Coach?   @relation(fields: [coachId], references: [id])
  summary   String
  total     Decimal  @db.Decimal(10, 2)
  method    String
  paid      Boolean  @default(true)
  /** Free-text comment on what this bills for (e.g. "PT sessions Sep 1-15") — shown on the invoice. */
  notes     String?
  /** Optional itemized breakdown: Array<{ description: string; quantity: number; unitPrice: number }>. Falls back to summary/total when absent. */
  lineItems Json?
  /** Tax rate charged on this sale (e.g. 0.05 for 5%), snapshotted from Settings at the time of sale so a later rate change never retroactively alters an old receipt. Null on sales recorded before tax tracking existed. */
  taxRate   Decimal? @db.Decimal(6, 4)
  /** Pre-billing period this sale covers (e.g. "2026-09-16" to "2026-09-30"), set only for period pre-bills. */
  periodFrom String?
  periodTo   String?
  sessionCredits SessionCredit[]
  createdAt DateTime @default(now())
}

/** One purchased session unit from a period pre-bill (Personal Training / Group Training).
    `appliedOccurrenceKey` links it to a specific scheduled session — that link is what makes
    reconciliation possible (the app always knows which sessions are already paid for) — but it's
    a plain nullable field, not a hard foreign key, since occurrences from a recurring series are
    computed dates, not persisted rows. Null means the credit is purchased but not yet applied to
    any session, which staff can do manually (or re-apply to a different session) at any time. */
model SessionCredit {
  id                   String   @id @default(cuid())
  saleId               String
  sale                 Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  memberId             String
  member               Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sessionType          String
  unitPrice            Decimal  @db.Decimal(10, 2)
  /** Which coach's rate this credit was bought at (Cory Martin's $115 PT session vs. Chris
      Campbell's $130 PT session are different products) — null only for the rare case of a
      credit purchased with no matching occurrence to derive a coach from. Scopes the "Paid with"
      switcher so a credit priced for one coach never gets manually applied to a different
      coach's session. */
  coachId              String?
  coach                Coach?   @relation(fields: [coachId], references: [id])
  appliedOccurrenceKey String?
  appliedIso           String?
  createdAt            DateTime @default(now())

  @@index([memberId])
  @@index([saleId])
  @@index([appliedOccurrenceKey])
}

/** Custom session types an admin adds beyond the six built-in ones (Personal Training, Group
    Training, Class, Remote Consult, Bodpod, Blueprint and Baseline), which stay hardcoded since
    scheduling logic is tuned around them. Both sets are merged for booking and display. */
model SessionType {
  id        String   @id @default(cuid())
  name      String   @unique
  duration  Int
  capacity  Int      @default(0)
  price     Float    @default(0)
  recurring Boolean  @default(true)
  createdAt DateTime @default(now())
}

/** POS catalog — every purchasable line item, price included. Per-coach Personal Training
    products (e.g. "Personal Training – Chris" at her own rate) link to that coach by `coachId`
    rather than parsing the coach's name out of the product name. `active: false` retires a
    product from POS/Settings without breaking a historical Sale.lineItems reference to it. */
model Product {
  id            String   @id @default(cuid())
  name          String   @unique
  category      String
  price         Float    @default(0)
  meta          String   @default("")
  recur         String?
  variablePrice Boolean  @default(false)
  /** Which session type this maps to, for color-coding that matches the Schedule. Null for items
      with no 1:1 session type (memberships, gift cards, apparel). */
  sessionType   String?
  coachId       String?
  coach         Coach?   @relation(fields: [coachId], references: [id])
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

/** Single-row business-wide settings (Settings > Facility/Payments/Notifications). Always read/written
    at id "singleton" — there's exactly one business. */
model BusinessSettings {
  id               String   @id @default("singleton")
  businessName     String   @default("2110 Fitness")
  address          String   @default("5824 Burbank Rd SE, Calgary, AB")
  phone            String   @default("+1 403 555 2110")
  timezone         String   @default("Mountain (MDT)")
  opens            String   @default("6:00 AM")
  closes           String   @default("8:00 PM")
  bookingIncrement String   @default("15 minutes")
  calendarView     String   @default("Week")
  /** { selfBook, waitlist, requireCard, allowDouble } */
  bookingFlags     Json     @default("{\"selfBook\":true,\"waitlist\":true,\"requireCard\":false,\"allowDouble\":false}")
  currency         String   @default("CAD")
  salesTax         String   @default("GST 5%")
  /** Flat payroll rate for Bodpod / Class (and any custom session type) hours. */
  hourlyPayRate    Float    @default(20)
  /** { emailReceipt, autoCharge, packageAlert, dailySummary } */
  paymentsFlags    Json     @default("{\"emailReceipt\":true,\"autoCharge\":true,\"packageAlert\":true,\"dailySummary\":false}")
  /** { reminder, cancelNotice, waitlistOpen, birthday, marketing } */
  notifyFlags      Json     @default("{\"reminder\":true,\"cancelNotice\":true,\"waitlistOpen\":true,\"birthday\":false,\"marketing\":false}")
  reminderTiming   String   @default("24 hours before")
  packageWarning   String   @default("2 sessions left")
  dailySummaryTo   String   @default("cory@2110fitness.com")
  updatedAt        DateTime @updatedAt
}
