generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Coach {
  id      String   @id
  name    String
  email   String   @unique
  role    String
  active  Boolean  @default(true)
  members Member[]
}

model Member {
  id            String          @id @default(cuid())
  firstName     String
  lastName      String
  email         String          @unique
  phone         String
  gender        String
  address       String?
  postalCode    String?
  city          String?
  province      String?
  plan          String          @default("No plan yet")
  balance       Decimal         @default(0) @db.Decimal(10, 2)
  since         String
  lastSession   String
  coachId       String?
  coach         Coach?          @relation(fields: [coachId], references: [id])
  payerOf       SharedAccount[] @relation("Payer")
  beneficiaryOf SharedAccount[] @relation("Beneficiary")
  createdAt     DateTime        @default(now())
}

model SharedAccount {
  id            String @id @default(cuid())
  payerId       String
  payer         Member @relation("Payer", fields: [payerId], references: [id], onDelete: Cascade)
  beneficiaryId String
  beneficiary   Member @relation("Beneficiary", fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@unique([payerId, beneficiaryId])
}
